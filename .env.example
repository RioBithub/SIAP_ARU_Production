# === MySQL ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aru_siap
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# Set to +07:00 only if MySQL DATETIME values are stored in WIB; otherwise keep Z (UTC).
DB_TIMEZONE=Z
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# === App ===
SESSION_SECRET=CHANGE_WITH_64_HEX_OR_LONG_RANDOM_STRING
APP_URL=http://localhost:3000
UPLOAD_DIR=./storage

# === First root account (used by npm run db:init) ===
INIT_ROOT_NAME=Root Administrator
INIT_ROOT_EMAIL=root@aruraharja.co.id
INIT_ROOT_PASSWORD=


# === ARU correspondence ===
# Absolute path to the service account JSON used for the read-only Google Sheets register.
ARU_SHEETS_SERVICE_ACCOUNT_FILE=
# Directory with the licensed arial.ttf and arialbd.ttf for ARU correspondence PDFs.
ARU_ARIAL_FONT_DIR=
